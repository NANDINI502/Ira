# Ira Environment Configuration
# Copy this file to .env and fill in your values

# ============ LLM Settings ============
# Adjust based on your GPU VRAM:
# 6GB VRAM: llava:7b
# 10GB VRAM: llava:13b  
# 24GB VRAM: llava:34b or llama3.2-vision
LLM_MODEL=llava:7b
EMBEDDING_MODEL=nomic-embed-text

# Chat settings
TEMPERATURE=0.7
CONTEXT_WINDOW=4096

# ============ Home Assistant (Optional) ============
# Uncomment and fill in if you have Home Assistant
# HOME_ASSISTANT_URL=http://192.168.1.100:8123
# HOME_ASSISTANT_TOKEN=your-long-lived-access-token

# ============ Voice Settings ============
VOICE_ENABLED=true

# ============ Server Settings ============
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=true
